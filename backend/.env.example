# AI Capability Layer (Faz 0+) — prod'da önce AI_ENABLED=false
# Seçenek A: Doğrudan OpenAI (Azure gerekmez)
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
# Seçenek B: Azure OpenAI (OPENAI_API_KEY boşken)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_CHAT=
AI_MONTHLY_TOKEN_QUOTA=200000
AI_MAX_OUTPUT_TOKENS=600
AI_LLM_TIMEOUT_SEC=25
AI_INCLUDE_PII=false
AI_INCLUDE_NOTES=true
AI_STORE_OUTPUT=false
# Faz 4: sabah/gün sonu mailine kısa AI paragrafı (LLM hata verirse mail yine gider)
AI_DAILY_EMAIL=false
# Faz 5: global satış asistanı (POST /api/ai/chat, SSE /api/ai/chat/stream)
AI_CHAT_ENABLED=false
# openai | azure — genel AI/chat yönlendirmesi; DE-3 teşhis yorumu her zaman yalnızca OpenAI API (OPENAI_API_KEY)
AI_PROVIDER=openai
# DE-3: teşhis yorumu (POST /api/ai/diagnosis/interpret) — diagnosis_engine + AI_ENABLED + OPENAI_API_KEY
AI_DIAGNOSIS_INTERPRET_ENABLED=false
# Boş bırakılırsa OPENAI_CHAT_MODEL / Azure chat deployment kullanılır
AI_DIAGNOSIS_MODEL=
AI_DIAGNOSIS_INTERPRET_CACHE_TTL_HOURS=48
AI_DIAGNOSIS_INTERPRET_MAX_OUTPUT_TOKENS=450
AI_DIAGNOSIS_INTERPRET_TEMPERATURE=0.2
AI_DIAGNOSIS_INTERPRET_ESTIMATED_TOKENS=1200
# DE-4 Stage 4.4: map DE-3 recommended_actions → ai_actions (proposed only)
AI_DE4_INTERPRET_PROPOSAL_BRIDGE_ENABLED=false
