# Sunucu için backend/.env örneği
# Kullanım: sunucuda backend/.env olarak kaydedin — gerçek değerleri kendiniz üretin

APP_ENV=production

# Güvenlik — openssl rand -hex 32 ile üretin
SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32
APP_URL=https://saleshub.behtechlabs.com
CORS_ORIGINS=https://saleshub.behtechlabs.com

# Oturum
ACCESS_TOKEN_EXPIRE_MINUTES=30
REMEMBER_ME_EXPIRE_DAYS=30
IDLE_TIMEOUT_MINUTES=30

# PostgreSQL
DATABASE_URL=postgresql+psycopg2://behtech_crm_user:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/behtech_crm_db

# Admin hesabı — ilk kurulumda kullanılır, güçlü şifre seçin
SEED_ADMIN_USERNAME=behlul
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# E-posta
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_VERIFICATION_ENABLED=true
