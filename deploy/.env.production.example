# === Docker Compose (postgres) ===
POSTGRES_DB=behtech_crm_db
POSTGRES_USER=behtech_crm_user
POSTGRES_PASSWORD=degistirin-guclu-db-sifresi

# Host'ta dinlenecek benzersiz port (sadece localhost)
# Sunucuda çakışma varsa örn. 18081 yapın: ss -tlnp | grep 18080
APP_HOST_PORT=18080

# === Backend (deploy/.env.production) ===
SECRET_KEY=degistirin-uzun-rastgele-secret-key
APP_URL=https://saleshub.behtechlabs.com
CORS_ORIGINS=https://saleshub.behtechlabs.com

ACCESS_TOKEN_EXPIRE_MINUTES=30
REMEMBER_ME_EXPIRE_DAYS=30
IDLE_TIMEOUT_MINUTES=30

SEED_ADMIN_USERNAME=behlul
SEED_ADMIN_EMAIL=behlulalar32@gmail.com
SEED_ADMIN_PASSWORD=degistirin-guclu-admin-sifresi

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=behlulalar@behtechlabs.com
SMTP_PASSWORD=app-password-buraya
SMTP_FROM=info@behtechlabs.com
EMAIL_VERIFICATION_ENABLED=true
