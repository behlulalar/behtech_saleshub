# BehTech Sales Hub — yedekleme ayarları
# Kurulum: cp deploy/backup.env.example /opt/behtech-sales-hub/deploy/backup.env
#
# Google Drive'da kendiniz bir klasör oluşturun (berber sistemindeki randevu_yedekleri gibi).
# RCLONE_DEST, Drive'daki klasör adıyla birebir aynı olmalı.

# Yerel sunucu yedekleri (Drive'a kopyalandıktan sonra kısa süre tutulur)
BACKUP_DIR=/var/backups/behtech-crm
UPLOADS_BACKUP_DIR=/var/backups/behtech-crm/uploads
RETENTION_DAYS=7
UPLOADS_RETENTION_DAYS=7

# Google Drive — behlulalar32@gmail.com (rclone config ile bağlanır)
RCLONE_REMOTE=gdrive
# Drive'da oluşturacağınız klasör adı (ör. randevu_yedekleri → saleshub_yedekleri)
RCLONE_DEST=saleshub_yedekleri
DRIVE_RETENTION_DAYS=365
